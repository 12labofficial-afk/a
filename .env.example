# Docker Compose is asked to read from ".env" in this same folder (optional — safe to leave blank).
# Copy this file to ".env" and fill in whichever key you have.

# DeepSeek official API (https://platform.deepseek.com) — tried first
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# Hugging Face Inference API — tried if DeepSeek is not configured or fails
HF_TOKEN=
HF_MODEL=deepseek-ai/DeepSeek-V3-0324

# Video output settings
VIDEO_WIDTH=1280
VIDEO_HEIGHT=720
VIDEO_FPS=24
